<popup>
    <model>
	{
		"title": "",
		"message": "",
		"onYes": null,
		"onNo": null,
		"visibility": "collapsed"
	}
	</model>
	<style>
	.wood-panel {
		width: auto;
		height: 220px;
		halign: center;
		valign: center;
		backgroundimage: "Assets/seamless-texture-wood-old-oak-small2.jpg";
		shadow: 0 8 16 rgba(0,0,0,0.5);
	}
	</style>

    <overlay visibility="@visibility">
        <grid class="wood-panel">
            <vstack spacing="8" padding="12">
                <hstack>
                    <label value="@title" class="popup-title" />
                </hstack>
                <vstack margin="6">
                    <label value="@message" class="popup-message" />
                </vstack>
                <hstack spacing="10" halign="center">
                    <button onclick="@onYes">YES</button>
                    <button onclick="@onNo">NO</button>
                </hstack>
            </vstack>
        </grid>
    </overlay>
</popup>
