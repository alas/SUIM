<root>
    <model>
	{
		"title": "",
		"message": "",
		"visibility": null,
		"onYes": null,
		"onNo": null,
		"onClose": null
	}
	</model>
	<style>
	.window {
		width: 500px;
		height: 220px;
		padding: 12px;
		background-image: url(Assets/seamless-texture-wood-old-oak-small2.jpg);
	}
	.title {
		justify-content: space-between;
		align-items: center;
	}
	.content {
		margin: 6px;
		flex-grow: 1;
		justify-content: center;
	}
	.buttons {
		gap: 10;
		justify-content: space-between;
	}
	</style>
    <overlay visibility="@visibility">
		<dock class="window">
			<hstack class="title" >
				<h1>@title</h1>
				<button onclick="@onClose" width="30" height="30">X</button>
			</hstack>
			<vstack class="content">
				<h3>@message</h3>
			</vstack>
			<hstack class="buttons">
				<button onclick="@onYes">YES</button>
				<button onclick="@onNo">NO</button>
			</hstack>
		</dock>
    </overlay>
</root>
