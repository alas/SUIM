<popup>
    <model>
	{
		"title": "",
		"message": "",
		"onYes": null,
		"onNo": null,
		"visibility": null
	}
	</model>
	<style>
	.wood-panel {
		width: auto;
		height: 220px;
		justify-self: center;
		align-items: center;
		backgroundimage: "Assets/seamless-texture-wood-old-oak-small2.jpg";
		/*shadow: 0 8 16 rgba(0,0,0,0.5);*/
	}
	.hstack2 {
		gap: 10;
		justify-self: center;
	}
	</style>

    <overlay visibility="@visibility">
        <grid class="wood-panel">
            <vstack gap="8" padding="12">
                <hstack>
                    <label value="@title" />
                </hstack>
                <vstack margin="6">
                    <label value="@message" />
                </vstack>
                <hstack class="hstack2">
                    <button onclick="@onYes">YES</button>
                    <button onclick="@onNo">NO</button>
                </hstack>
            </vstack>
        </grid>
    </overlay>
</popup>
