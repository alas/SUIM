<popup>
    <model>
    {
        "title": "",
        "message": "",
        "onYes": null,
        "onNo": null,
        "visibility": "collapsed"
    }
    </model>

    <overlay visibility="@visibility">
        <grid width="auto" height="220" halign="center" valign="center" class="wood-panel" shadow="0 8 16 rgba(0,0,0,0.5)" backgroundimage="Assets/seamless-texture-wood-old-oak-small2.jpg">
            <vstack spacing="8" padding="12">
                <hstack>
                    <label value="@title" class="popup-title" />
                </hstack>
                <vstack margin="6">
                    <label value="@message" class="popup-message" />
                </vstack>
                <hstack spacing="10" halign="center">
                    <button onclick="@onYes">YES</button>
                    <button onclick="@onNo">NO</button>
                </hstack>
            </vstack>
        </grid>
    </overlay>
</popup>
