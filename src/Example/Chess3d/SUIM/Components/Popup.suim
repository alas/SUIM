<root>
    <model>
	{
		"title": "",
		"message": "",
		"visibility": null,
		"onYes": null,
		"onNo": null,
		"onClosing": null
	}
	</model>
	<style>
	.window {
		width: 500px;
		height: 330px;
		padding: 12px;
		background-image: url(Assets/seamless-texture-wood-old-oak-small2.jpg);
	}
	.title {
		width: 100%;
		flex-grow: 1;
		justify-content: space-between;
		align-items: center;
	}
	.content {
		width: 100%;
		height: 100%;
		margin: 6px;
		flex-grow: 1;
		justify-content: center;
	}
	.buttoncontainer {
		width: 100%;
		height: auto;
		gap: 10;
		justify-content: space-between;
	}
	</style>
    <overlay visibility="@visibility">
		<dock class="window">
			<hstack class="title" >
				<h1>@title</h1>
				<button onclick="OnClosingInternal()" width="30" height="30">X</button>
			</hstack>
			<vstack class="content">
				<h3>@message</h3>
			</vstack>
			<hstack class="buttoncontainer">
				<button onclick="@onYes">YES</button>
				<button onclick="OnNoInternal()">NO</button>
			</hstack>
		</dock>
    </overlay>
</root>
