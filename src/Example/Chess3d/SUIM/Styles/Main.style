* {
    HorizontalAlignment: Left;
    VerticalAlignment: Top;
    Color: Green;
    FontSize: 16;
}
text {
    HorizontalAlignment: Center;
    VerticalAlignment: Center;
}
button {
    Background: Black;
    Width: 200;
    Height: 50;
    Margin: 5;
    normal: "../Assets/btn_normal.png";
    hover: "../Assets/btn_hover.png";
    pressed: "../Assets/btn_pressed.png";
}
.container {
    HorizontalAlignment: Left;
    VerticalAlignment: Top;
    Padding: 10;
}
